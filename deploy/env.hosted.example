# Copy to .env next to docker-compose.yml on the server, and fill in what applies.
# Keys can also be typed into the app's Settings page later; those are stored in the data volume.

# The address people use, exactly as in the browser. Needed for "Connect Google Drive".
BROLL_PUBLIC_URL=https://library.example.com

# Google Gemini key (Adam's own). Can be set here or in Settings.
GEMINI_API_KEY=

# Google OAuth client (type: Web application) for "Connect Google Drive". Can be set in Settings instead.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Way in, option 1 (recommended): your own domain served by Caddy, with HTTPS. No upload size limit.
# A domain name whose DNS points at this server, e.g. library.example.com. Also set the password below.
BROLL_DOMAIN=

# The shared password for everyone on the team. Use a long one: 4 random words is plenty.
BROLL_ACCESS_PASSWORD=

# Way in, option 2: Cloudflare Tunnel with Cloudflare Access doing the login (leave the password out).
# Cloudflare caps uploads at 100 MB on the free plan, so big clips fail; photos and small files are fine.
# Token from Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional
# BROLL_LIBRARY_NAME=Adam Kunder B-Roll
# BROLL_WORKSPACE=library
