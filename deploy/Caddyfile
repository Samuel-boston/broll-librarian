# HTTPS for your own domain, with a certificate fetched and renewed automatically.
# Point the domain's DNS at this server, set BROLL_DOMAIN in .env, and set BROLL_ACCESS_PASSWORD too:
# without Cloudflare Access in front, the shared password is the only lock.
{$BROLL_DOMAIN} {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }

    # Pages anyone on the internet can reach without the password (the login form, the JSON API) take small
    # bodies only, so a stranger cannot make the server write gigabytes to disk. The one API route that
    # takes files, and everything behind the password, may be large.
    @open {
        path /login /api/*
        not path /api/upload
    }
    handle @open {
        request_body {
            max_size 64KB
        }
        reverse_proxy librarian:8000 {
            flush_interval -1
        }
    }
    handle {
        request_body {
            max_size 20GB
        }
        reverse_proxy librarian:8000 {
            flush_interval -1
        }
    }
}
