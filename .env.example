# B-Roll Librarian secrets. Copy to .env (in the repo, or in $BROLL_HOME) and fill in.
# Never commit .env. Nothing here is ever written to the database or config.yaml.

# --- Vision / text provider keys. You only need the one your workspace uses. ---

# Google Gemini - the default provider. Cheapest per image for bulk indexing.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude - richest structured descriptions, higher cost per clip.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Google Drive OAuth (needed from M3 onwards) ---
# Downloaded from your own Google Cloud project - see the README walkthrough.
# The OAuth token itself is stored per workspace at
# ~/.broll/workspaces/<id>/drive_token.json and is not set here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Optional ---
# Override where workspaces live (default: ~/.broll)
# BROLL_HOME=/Users/you/.broll
# Default workspace for commands that omit --workspace
# BROLL_WORKSPACE=my-library
